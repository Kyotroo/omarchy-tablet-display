#!/usr/bin/env python3
"""Executable entrypoint. Adds this directory to sys.path so the daemon runs
straight out of the plugin checkout with no install step, matching how the
rest of the plugin is just files under ~/.config/omarchy/plugins/<id>/."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from tabletdisplayd.main import run  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(run())
