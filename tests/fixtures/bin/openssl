#!/usr/bin/env python3
"""Fake openssl for tests: writes placeholder cert/key files instead of
actually generating a keypair, so tests stay fast and deterministic."""
import sys


def main(argv):
    if argv[:2] != ["req", "-x509"]:
        print(f"fake openssl: unhandled command {argv}", file=sys.stderr)
        return 1
    key_path = argv[argv.index("-keyout") + 1]
    cert_path = argv[argv.index("-out") + 1]
    with open(key_path, "w") as f:
        f.write("fake private key\n")
    with open(cert_path, "w") as f:
        f.write("fake certificate\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
