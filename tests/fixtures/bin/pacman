#!/bin/bash
# Fake `pacman` for tests: only supports `-S --noconfirm --needed <pkg>`.
# Plain bash (not python) deliberately -- test_deps.sh runs this under a
# minimal PATH that only guarantees a shell, not `env python3`.
if [[ "$1 $2 $3" == "-S --noconfirm --needed" ]]; then
  if [[ -n $FAKE_PACMAN_FAILS ]]; then
    echo "error: fake failure" >&2
    exit 1
  fi
  echo "installing ${*:4}..."
  exit 0
fi

echo "fake pacman: unhandled command $*" >&2
exit 1
